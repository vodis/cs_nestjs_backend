### APP
CS_NETWORK=
DEFAULT_LANGUAGE=
COOKIES_DOMAIN=
# Comma-separated origins for production CORS. In development (NODE_ENV != production) all origins are allowed.
ALLOWED_ORIGIN=http://localhost:5000,*.craftscript.com

# Orchestrator production secrets (Vault on host; names only in catalog)
# DATABASE_URL=
# API_SIGNING_KEY=

### DB
DB_CLIENT=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

DB_LOGGING=
SERVER_PORT=

HYPERLIQUID_API_URL=
HYPERLIQUID_WS_URL=

CS_I18N_SERVICE_URL=

ONE_CLICK_URL=https://1click.chaindefuser.com
ONE_CLICK_API_KEY=
ONE_CLICK_JWT_PUBLIC_KEY=https://partners.near-intents.org/.well-known/jwks.json
INTENTS_EXPLORER_API_KEY=
SOLVER_RELAY_API_URL=
INTENTS_MESSAGE_BUS_API_KEY=
