### APP
SERVER_PORT=5003
CS_NETWORK=cs-network
DEFAULT_LANGUAGE=
COOKIES_DOMAIN=
# Comma-separated CORS origins. Dev allows all.
ALLOWED_ORIGIN=*.craftscript.com,http://localhost:5001,http://127.0.0.1:5001
# API_SIGNING_KEY=

### DB
# Uncomment one target. DATABASE_URL overrides DB_*.
# Shared local Postgres: docker network create cs-network && docker compose up -d db
# - Host processes (pnpm): DB_HOST=localhost
# - Containers on cs-network (backend app / i18n compose): DB_HOST=db_cs
DB_LOGGING=false

# --- Local ---
DB_CLIENT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cs_main_db
DB_USER=postgres
DB_PASSWORD=

# --- Staging ---
# DATABASE_URL=postgresql://USER:PASSWORD@STAGING_HOST:5432/cs_main_db
# DB_CLIENT=postgres
# DB_HOST=
# DB_PORT=5432
# DB_NAME=cs_main_db
# DB_USER=
# DB_PASSWORD=

# --- Production ---
# DATABASE_URL=postgresql://USER:PASSWORD@PRODUCTION_HOST:5432/cs_main_db
# DB_CLIENT=postgres
# DB_HOST=
# DB_PORT=5432
# DB_NAME=cs_main_db
# DB_USER=
# DB_PASSWORD=

HYPERLIQUID_API_URL=
HYPERLIQUID_WS_URL=

CS_I18N_SERVICE_URL=

ONE_CLICK_URL=https://1click.chaindefuser.com
ONE_CLICK_API_KEY=
ONE_CLICK_JWT_PUBLIC_KEY=https://partners.near-intents.org/.well-known/jwks.json
INTENTS_EXPLORER_API_KEY=
SOLVER_RELAY_API_URL=
INTENTS_MESSAGE_BUS_API_KEY=
SOLVER_RELAY_TIMEOUT_MS=5000
SWAP_MAX_SLIPPAGE_BPS=1000
SWAP_MIN_DEADLINE_MS=60000
ASSETS_CACHE_TTL_MS=300000

### Backend-only chain RPC providers
NEAR_RPC_URL=https://rpc.mainnet.near.org
NEAR_RPC_TIMEOUT_MS=5000
NEAR_BALANCE_TTL_MS=15000

### Market history providers
COINGECKO_API_URL=https://api.coingecko.com/api/v3
GECKOTERMINAL_API_URL=https://api.geckoterminal.com/api/v2
GECKOTERMINAL_API_VERSION=20230302
GECKOTERMINAL_RATE_LIMIT_PER_MINUTE=30
MARKET_HISTORY_PROVIDER_ORDER=hyperliquid,coingecko,geckoterminal
MARKET_HISTORY_CACHE_TTL_MS=300000
MARKET_HISTORY_RESOLUTION_CACHE_TTL_MS=86400000
MARKET_HISTORY_HTTP_TIMEOUT_MS=10000
MARKET_HISTORY_ENABLE_GECKOTERMINAL=false

### Privy
# Uncomment one target.

# --- Local ---
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_JWKS_URL=

# --- Staging ---
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# PRIVY_JWKS_URL=

# --- Production ---
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# PRIVY_JWKS_URL=

PRIVY_LOGIN_METHODS=email,google,apple,passkey
PRIVY_PASSKEY_LOGIN_ENABLED=true
PRIVY_PASSKEY_LINK_ENABLED=true
PRIVY_EMBEDDED_WALLET_ENABLED=true
EXTERNAL_WALLET_BINDING_ENABLED=true
# Dev only: skip JWT signature checks.
PRIVY_AUTH_DEV_ALLOW_UNSIGNED=false

### Agent portfolio access
AGENT_INTEGRATIONS_ENABLED=false
AGENT_PUBLIC_BASE_URL=https://api.craftscript.com
APP_PUBLIC_BASE_URL=https://craftscript.com
